# Bhao.pk Backend Environment Variables
PORT=3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Redis (optional — graceful fallback if unavailable)
REDIS_URL=redis://localhost:6379

# Email (Resend)
RESEND_API_KEY=re_your_key
EMAIL_FROM=alerts@bhao.pk

# CORS — comma-separated allowed origins (leave empty for dev = allow all)
CORS_ORIGIN=https://bhao.pk,https://bhao-pk.vercel.app
